# OpenEMR connection
OPENEMR_BASE=https://localhost:9300
OPENEMR_VERIFY_TLS=false

# OAuth2 confidential client (created by scripts/bootstrap_client.py)
COPILOT_CLIENT_ID=
COPILOT_CLIENT_SECRET=

# Dev user whose AAA the agent inherits (password grant for local dev only;
# production uses SMART authorization-code + EHR launch). See D-2.
COPILOT_DEV_USER=drhouse
COPILOT_DEV_PASS=DocPass123!

# Recent-window filter for fat endpoints (Observation), per D-7 / DQ-3.
COPILOT_LAB_LOOKBACK_MONTHS=18
COPILOT_LAB_MAX=200
