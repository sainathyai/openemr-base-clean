# OpenEMR connection
OPENEMR_BASE=https://localhost:9300
OPENEMR_VERIFY_TLS=false

# OAuth2 confidential client (created by scripts/bootstrap_client.py)
COPILOT_CLIENT_ID=
COPILOT_CLIENT_SECRET=

# Dev user whose AAA the agent inherits (password grant for local dev only;
# production uses SMART authorization-code + EHR launch). See D-2.
COPILOT_DEV_USER=drhouse
COPILOT_DEV_PASS=DocPass123!

# Recent-window filter for fat endpoints (Observation), per D-7 / DQ-3.
COPILOT_LAB_LOOKBACK_MONTHS=18
COPILOT_LAB_MAX=200

# LLM (optional). Without ANTHROPIC_API_KEY the deterministic stub narrator/chat
# is used, so the graph, gate, and tests all run offline.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-5

# Langfuse observability (optional). Without keys, tracing is a no-op.
# See OBSERVABILITY.md. Cloud host: https://cloud.langfuse.com
# Self-host host: http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
