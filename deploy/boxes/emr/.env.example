# EMR box .env
EMR_IMAGE=<acct>.dkr.ecr.<region>.amazonaws.com/copilot-emr:latest
DB_HOST=10.0.0.11                 # DB box PRIVATE IP (terraform output db_private_ip)
EMR_HOST=10.0.0.12                # this EMR box PRIVATE IP (terraform output emr_private_ip)
DB_ROOT_PASSWORD=change-me-strong-root-pass   # same as the DB box
OE_PASS=pass
