# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
region        = "us-east-1"
key_name      = "your-ec2-keypair-name"   # the key pair you created in the console
my_ip_cidr    = "203.0.113.4/32"          # your public IP /32  (curl -s https://checkip.amazonaws.com)
instance_type = "t3.micro"
domain        = "copilot.aspenitservices.com"
